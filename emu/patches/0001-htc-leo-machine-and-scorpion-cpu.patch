+/*
+ * Hooks into the oldarmemu leojit engine (target/arm/leojit), weak so
+ * that targets without it link unchanged.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef ACCEL_TCG_LEOJIT_HOOKS_H
+#define ACCEL_TCG_LEOJIT_HOOKS_H
+
+#include "accel/tcg/tb-cpu-state.h"
+
+bool leo_jit_enabled(void) __attribute__((weak));
+bool leo_jit_exec(CPUState *cs, TCGTBCPUState *s) __attribute__((weak));
+bool leo_jit_invalidate(ram_addr_t start, ram_addr_t last) __attribute__((weak));
+void leo_jit_after_tb(CPUState *cs) __attribute__((weak));
+void leo_jit_flush(void) __attribute__((weak));
+/* QEMU dropped its virtual-PC jump cache: virtual mappings changed */
+void leo_jit_flush_jc(void) __attribute__((weak));
+void leo_jit_flush_jc_page(vaddr page) __attribute__((weak));
+
+#endif
