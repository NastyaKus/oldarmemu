+/*
+ * Map a raw image file instead of reading it block by block through the
+ * block layer: each blk_pread() from the vCPU thread is a round trip
+ * through the I/O thread pool, which made an emulated phone's SD card
+ * slow.  The page cache writes the mapping back to the file.
+ */
+static void sd_map_file(SDState *sd, int64_t size)
+{
+    BlockDriverState *bs = blk_bs(sd->blk);
+    void *p;
+    int fd;
+
+    if (getenv("QEMU_SD_NOMAP") || size <= 0 || !bs || !bs->drv ||
+        strcmp(bs->drv->format_name, "raw") || !bs->file ||
+        !bs->file->bs->drv || strcmp(bs->file->bs->drv->format_name, "file")) {
+        return;
+    }
+    fd = qemu_open_old(bs->file->bs->filename, O_RDWR);
+    if (fd < 0) {
+        return;
+    }
+    p = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (p != MAP_FAILED) {
+        sd->map = p;
+        sd->map_size = size;
+    }
+}
